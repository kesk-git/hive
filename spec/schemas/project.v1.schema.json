{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:project:v1",
  "title": "Project identity record",
  "description": "One project registered under one workspace. See spec/identities.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "project_id",
    "workspace_id",
    "home_id",
    "slug",
    "name",
    "repository",
    "state",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "hive.project"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "home_id": {
      "description": "The Fleet home that holds this registration.",
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "slug": {
      "description": "Unique within its workspace. Fixed at creation.",
      "$ref": "urn:hive:schema:common:v1#/$defs/slug"
    },
    "name": {
      "$ref": "urn:hive:schema:common:v1#/$defs/label"
    },
    "repository": {
      "$ref": "urn:hive:schema:project:v1#/$defs/repository"
    },
    "state": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "$defs": {
    "repository": {
      "description": "Where the project's source lives. github binds a forge repository; local-only binds none and no forge identity is invented for it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "github",
            "local-only"
          ]
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,251}[a-z0-9])?$"
        },
        "owner": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]{1,100}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "github"
              }
            }
          },
          "then": {
            "required": [
              "host",
              "owner",
              "name"
            ]
          },
          "else": {
            "properties": {
              "host": false,
              "owner": false,
              "name": false
            }
          }
        }
      ]
    }
  }
}
