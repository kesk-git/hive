{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-word.verify.response:v1",
  "title": "hive-word verify: response body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verified_at",
    "stands",
    "reasons",
    "holds",
    "questions"
  ],
  "properties": {
    "verified_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "stands": {
      "description": "For an authority: the word stands. For a task: no word hold on it is unresolved. For a hold: it is released. For a question: it has an applied answer.",
      "type": "boolean"
    },
    "reasons": {
      "description": "Why not, when stands is false: unanswered, deferred, unreconciled, superseded, completed-without-answer, out-of-scope, not-found, malformed.",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "holds": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.hold:v1"
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.question:v1"
      }
    }
  }
}
