{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-pool.add.request:v1",
  "title": "hive-pool add: request body",
  "description": "Adds one item to the Pool in the request's scope. The Pool mints the task_id. See spec/pool.md, Items.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title"
  ],
  "properties": {
    "title": {
      "$ref": "urn:hive:schema:common:v1#/$defs/label"
    },
    "body": {
      "type": "string"
    },
    "level": {
      "description": "Required for a new item whose deliverable is not a decision; a decision item carries none.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/level"
    },
    "wave": {
      "description": "On a Target only.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/wave"
    },
    "deliverable": {
      "description": "Absent on a Target, which carries no deliverable.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/deliverable"
    },
    "class": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/dispatch_class"
    },
    "priority": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/priority"
    },
    "placement_requested": {
      "description": "Absent means policy.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/placement"
    },
    "delivery": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/delivery"
    },
    "specification_required": {
      "type": "boolean"
    },
    "definition": {
      "description": "Absent means not-required; when the item needs an accepted specification, needed if it has no effective specification and accepted if it resolves one through its parent.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/definition_state"
    },
    "deps": {
      "description": "Each blocked-by edge must name an item of this Pool that exists; a dangling blocker is refused. The parent rule of spec/pool.md, Levels, holds for the item as added: a Hunt has exactly one parent edge, to a Prey; a Prey at most one, to a Target; a Target none; a violation, or a Hunt attached to a Prey that carries the completion marker, is in flight or has an open generation, is refused with pool.hierarchy.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/dependency"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/link"
      }
    },
    "schedule": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/schedule"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "deliverable"
        ],
        "properties": {
          "deliverable": {
            "const": "decision"
          }
        }
      },
      "then": {
        "properties": {
          "level": false
        }
      },
      "else": {
        "required": [
          "level"
        ]
      }
    },
    {
      "if": {
        "required": [
          "level"
        ],
        "properties": {
          "level": {
            "const": "target"
          }
        }
      },
      "then": {
        "properties": {
          "deliverable": false,
          "placement_requested": false,
          "delivery": false
        }
      },
      "else": {
        "properties": {
          "wave": false
        }
      }
    }
  ]
}
