{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-pool.answer-question.response:v1",
  "title": "hive-pool answer-question: response body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "round",
    "answer_sequence",
    "disposition",
    "duplicate"
  ],
  "properties": {
    "question": {
      "$ref": "urn:hive:schema:records:pool.question:v1"
    },
    "round": {
      "$ref": "urn:hive:schema:records:pool.decision-round:v1"
    },
    "hold": {
      "description": "The hold, released or still active.",
      "$ref": "urn:hive:schema:records:pool.hold:v1"
    },
    "answer_sequence": {
      "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
    },
    "disposition": {
      "enum": [
        "released",
        "completed",
        "deferred",
        "unreconciled"
      ]
    },
    "duplicate": {
      "description": "True when an answer to this question with the same source was already recorded: nothing was written and the receipts are the original ones.",
      "type": "boolean"
    }
  }
}
