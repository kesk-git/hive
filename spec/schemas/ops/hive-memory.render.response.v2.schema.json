{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-memory.render.response:v2",
  "title": "hive-memory render: response body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection",
    "unchanged"
  ],
  "properties": {
    "projection": {
      "$ref": "urn:hive:schema:records:pool.projection:v2"
    },
    "unchanged": {
      "description": "True when the rendering equals the current one in text, exact source revisions, rule inventory and budget revision: nothing was written.",
      "type": "boolean"
    }
  }
}
