{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-spec.accept.request:v1",
  "title": "hive-spec accept: request body",
  "description": "Records the acceptance of a specification revision by the Fleet's supervisor, or the Hive for its own item, and binds its criteria to the item by revision and digest. Technical acceptance settles no product choice, and a word hold the item carries stays until the decision intake releases it. The item's definition becomes accepted and any definition hold is released, as is the definition hold of every item that resolves its effective specification through it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "specification_id",
    "revision",
    "task_id"
  ],
  "properties": {
    "specification_id": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/specification_id"
    },
    "revision": {
      "description": "Must be the current revision.",
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "task_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
    },
    "admission": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
    },
    "need_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "coverage",
        "reason"
      ],
      "properties": {
        "outcome": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "coverage": {
          "enum": [
            "existing",
            "new-definition"
          ]
        },
        "reason": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "covering_specification": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/criteria_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "existing"
              }
            }
          },
          "then": {
            "required": [
              "covering_specification"
            ]
          },
          "else": {
            "properties": {
              "covering_specification": false
            }
          }
        }
      ]
    },
    "open_product_questions": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
      }
    }
  }
}
