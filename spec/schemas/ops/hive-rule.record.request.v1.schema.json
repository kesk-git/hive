{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-rule.record.request:v1",
  "title": "hive-rule record: request body",
  "description": "Records a ruling verbatim with its origin, scope from the envelope, subject, one rendered rule line and its applying authority. A temporary rule gives an expiry time, a lift condition or both. The words and dates given here are never changed afterwards. See spec/pool.md, Rules.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "words",
    "origin",
    "rule_line",
    "applies"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}(\\.[a-z][a-z0-9-]{0,62}){0,3}$"
    },
    "words": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
    },
    "origin": {
      "$ref": "urn:hive:schema:records:pool.rule:v1#/properties/origin"
    },
    "rule_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "applies": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.rule:v1#/$defs/role"
      }
    },
    "effective_at": {
      "description": "Absent means the command's clock.",
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "lift": {
      "$ref": "urn:hive:schema:records:pool.rule:v1#/properties/lift"
    },
    "changes": {
      "$ref": "urn:hive:schema:records:pool.rule:v1#/properties/changes"
    },
    "intake": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/link"
      }
    }
  }
}
