{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-memory.render.request:v2",
  "title": "hive-memory render: request body",
  "description": "Renders one tier and role audience using the authoritative budget configuration; subject tier requires a subject identity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "audience",
    "tier"
  ],
  "properties": {
    "audience": {
      "enum": [
        "hive",
        "fleet",
        "class-0",
        "class-1",
        "class-2",
        "class-3",
        "class-4",
        "class-5",
        "class-6",
        "class-7",
        "reviewer",
        "fixer",
        "validation"
      ]
    },
    "at": {
      "description": "The instant the rules are resolved for. Absent means the command's clock.",
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "tier": {
      "enum": [
        "always",
        "subject"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tier": {
            "const": "always"
          }
        }
      },
      "then": {
        "properties": {
          "subject_id": false,
          "audience": {
            "enum": [
              "hive",
              "fleet"
            ]
          }
        }
      },
      "else": {
        "required": [
          "subject_id"
        ]
      }
    }
  ]
}
