{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-word.answer.response:v1",
  "title": "hive-word answer: response body",
  "description": "Present with ok: the answer was recorded and applied, released, completed or deferred. An answer recorded unreconciled returns held, with no body, the hold in error.hold and the pool.answer.unreconciled receipt in receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "question",
    "answer_sequence",
    "disposition",
    "duplicate"
  ],
  "properties": {
    "question": {
      "$ref": "urn:hive:schema:records:pool.question:v1"
    },
    "round": {
      "$ref": "urn:hive:schema:records:pool.decision-round:v1"
    },
    "hold": {
      "$ref": "urn:hive:schema:records:pool.hold:v1"
    },
    "answer_sequence": {
      "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
    },
    "disposition": {
      "enum": [
        "released",
        "completed",
        "deferred"
      ]
    },
    "duplicate": {
      "type": "boolean"
    }
  }
}
