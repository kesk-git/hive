{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-imperative.deliver.request:v1",
  "title": "hive-imperative deliver: request body",
  "description": "Records exactly what one generation was given: the revision, the rendered text's digest and size, the transport and the receipt the caller holds for the delivery. Written by the dispatcher of a later stage after the transport accepted the text; stage 2 builds and proves the write with a test caller. The generation must be open on the item.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "generation",
    "revision",
    "renderer_version",
    "text_digest",
    "text_bytes",
    "transport",
    "evidence"
  ],
  "properties": {
    "task_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
    },
    "generation": {
      "$ref": "urn:hive:schema:common:v1#/$defs/generation"
    },
    "revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "renderer_version": {
      "$ref": "urn:hive:schema:common:v1#/$defs/implementation_version"
    },
    "text_digest": {
      "$ref": "urn:hive:schema:common:v1#/$defs/digest"
    },
    "text_bytes": {
      "$ref": "urn:hive:schema:common:v1#/$defs/byte_count"
    },
    "transport": {
      "enum": [
        "launch-prompt",
        "steer",
        "public-safe-prompt"
      ]
    },
    "evidence": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule_id",
          "record_revision"
        ],
        "properties": {
          "rule_id": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
          },
          "record_revision": {
            "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
          }
        }
      }
    },
    "subject_projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projection_id",
          "rendering",
          "digest",
          "rules"
        ],
        "properties": {
          "projection_id": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/projection_id"
          },
          "rendering": {
            "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
          },
          "digest": {
            "$ref": "urn:hive:schema:common:v1#/$defs/digest"
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "record_revision"
              ],
              "properties": {
                "rule_id": {
                  "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
                },
                "record_revision": {
                  "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
                }
              }
            }
          }
        }
      }
    },
    "rendered_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "rendered_text": {
      "type": "string",
      "minLength": 1,
      "description": "The exact text delivered; used transiently to check digest, size and labeled rule and projection inventories. Never persisted or logged."
    }
  }
}
