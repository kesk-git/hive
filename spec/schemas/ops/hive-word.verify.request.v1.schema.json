{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-word.verify.request:v1",
  "title": "hive-word verify: request body",
  "description": "Answers, read-only, whether the Mind's word stands: for an authority reference of kind word, whether it names a question of this home with an applied, unsuperseded answer in the envelope's scope; for a task, whether any word hold on it is unresolved; for a hold or a question, its state. A reference is never itself authority; this reads the record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject"
  ],
  "properties": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authority",
            "task",
            "hold",
            "question"
          ]
        },
        "authority": {
          "$ref": "urn:hive:schema:common:v1#/$defs/authority"
        },
        "task_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "hold_id": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/hold_id"
        },
        "question_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "authority"
              }
            }
          },
          "then": {
            "required": [
              "authority"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "task"
              }
            }
          },
          "then": {
            "required": [
              "task_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "hold"
              }
            }
          },
          "then": {
            "required": [
              "hold_id"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "question"
              }
            }
          },
          "then": {
            "required": [
              "question_id"
            ]
          }
        }
      ]
    }
  }
}
