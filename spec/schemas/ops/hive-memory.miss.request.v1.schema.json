{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-memory.miss.request:v1",
  "title": "hive-memory miss: request body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule",
    "actor",
    "step",
    "provenance",
    "observed_at"
  ],
  "properties": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "record_revision"
      ],
      "properties": {
        "rule_id": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
        },
        "record_revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        }
      }
    },
    "actor": {
      "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer_ref"
    },
    "step": {
      "enum": [
        "dispatch",
        "gate",
        "define",
        "stow",
        "project"
      ]
    },
    "provenance": {
      "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/provenance"
    },
    "observed_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "miss_id": {
      "type": "string",
      "pattern": "^miss_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    }
  }
}
