{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-rule.record.request:v2",
  "title": "hive-rule record: request body",
  "description": "Records an operating or product ruling; optional subject creation and mechanics facts are atomic with an operating rule. See spec/pool.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "subject",
    "words",
    "origin",
    "applies",
    "kind"
  ],
  "properties": {
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}(\\.[a-z0-9][a-z0-9-]{0,62}){0,3}$"
    },
    "words": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
    },
    "origin": {
      "$ref": "urn:hive:schema:records:pool.rule:v2#/properties/origin"
    },
    "rule_line": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "applies": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.rule:v2#/$defs/role"
      }
    },
    "effective_at": {
      "description": "Absent means the command's clock.",
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "lift": {
      "$ref": "urn:hive:schema:records:pool.rule:v2#/properties/lift"
    },
    "changes": {
      "$ref": "urn:hive:schema:records:pool.rule:v2#/properties/changes"
    },
    "intake": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/link"
      }
    },
    "kind": {
      "enum": [
        "operating",
        "product"
      ]
    },
    "tier": {
      "enum": [
        "always",
        "subject"
      ]
    },
    "filed_under": {
      "type": "string",
      "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "governs": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "target_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      },
      "oneOf": [
        {
          "required": [
            "target_id"
          ],
          "properties": {
            "stage": false
          }
        },
        {
          "required": [
            "stage"
          ],
          "properties": {
            "target_id": false
          }
        }
      ]
    },
    "create_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "key",
        "loads_at"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}(\\.[a-z0-9][a-z0-9-]{0,62}){0,3}$"
        },
        "loads_at": {
          "type": "array",
          "items": {
            "enum": [
              "dispatch",
              "gate",
              "define",
              "stow",
              "project"
            ]
          },
          "minItems": 1
        }
      }
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "text",
          "provenance"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}(\\.[a-z0-9][a-z0-9-]{0,62}){0,3}$"
          },
          "text": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          },
          "provenance": {
            "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/provenance"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "operating"
          }
        }
      },
      "then": {
        "required": [
          "tier",
          "filed_under",
          "rule_line"
        ],
        "properties": {
          "governs": false
        }
      },
      "else": {
        "required": [
          "governs"
        ],
        "properties": {
          "tier": false,
          "filed_under": false,
          "rule_line": false,
          "create_subject": false,
          "facts": false
        }
      }
    }
  ]
}
