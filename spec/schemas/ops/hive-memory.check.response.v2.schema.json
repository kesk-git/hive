{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:ops:hive-memory.check.response:v2",
  "title": "hive-memory check: response body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checked_at",
    "projections",
    "budget_revision",
    "subjects"
  ],
  "properties": {
    "checked_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "projection_id",
          "audience",
          "state",
          "bytes",
          "over_budget",
          "stale_sources",
          "duplicates",
          "drift",
          "max_bytes"
        ],
        "properties": {
          "projection_id": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/projection_id"
          },
          "audience": {
            "enum": [
              "hive",
              "fleet",
              "class-0",
              "class-1",
              "class-2",
              "class-3",
              "class-4",
              "class-5",
              "class-6",
              "class-7",
              "reviewer",
              "fixer",
              "validation"
            ]
          },
          "state": {
            "enum": [
              "fresh",
              "stale"
            ],
            "description": "Computed at the check from the rules in force at checked_at: fresh when they resolve to the rendering's rules_digest, the resolved-rule digest, with no conflict, and every non-rule source revision and the budget revision agrees; stale otherwise. The comparison names the rules digest and never the digest of the rendered text, so an unchanged rendering of changed rules is stale, and a changed fact, corrected provenance or budget revision makes it stale with the rules digest unchanged."
          },
          "bytes": {
            "$ref": "urn:hive:schema:common:v1#/$defs/byte_count"
          },
          "over_budget": {
            "type": "boolean"
          },
          "stale_sources": {
            "description": "Sources whose revision differs from the one rendered, rules now in force that the rendering did not read, and rules it read that are no longer in force at checked_at (expired by the clock, lifted, ended, superseded or not yet effective).",
            "type": "array",
            "items": {
              "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
            }
          },
          "duplicates": {
            "description": "Rule lines that appear in this projection and in another of the same scope and audience, which would be two copies of one fact. An always line in both the Hive and Fleet audience projections at Hive scope is intended, not a duplicate.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rule_id",
                "also_in"
              ],
              "properties": {
                "rule_id": {
                  "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
                },
                "also_in": {
                  "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/projection_id"
                }
              }
            }
          },
          "drift": {
            "description": "Consumers that received or acknowledged a digest other than the current one.",
            "type": "array",
            "items": {
              "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer"
            }
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "budget_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "subject_id",
          "independent_misses",
          "misses",
          "decision_due"
        ],
        "properties": {
          "subject_id": {
            "type": "string",
            "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          },
          "independent_misses": {
            "type": "integer",
            "minimum": 0
          },
          "misses": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^miss_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            }
          },
          "decision_due": {
            "type": "boolean"
          },
          "question_id": {
            "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
          }
        }
      }
    }
  }
}
