{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:workspace:v1",
  "title": "Workspace identity record",
  "description": "One workspace and the one Fleet home that owns it. See spec/identities.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "workspace_id",
    "slug",
    "name",
    "home_id",
    "parent_home_id",
    "state",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "hive.workspace"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "slug": {
      "description": "The key provisioning is idempotent on. Fixed at creation.",
      "$ref": "urn:hive:schema:common:v1#/$defs/slug"
    },
    "name": {
      "description": "The workspace's label, which is also its Fleet's name. Changing it changes no identity.",
      "$ref": "urn:hive:schema:common:v1#/$defs/label"
    },
    "home_id": {
      "description": "The Fleet home that owns the workspace.",
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "parent_home_id": {
      "description": "The Hive's home.",
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "state": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  }
}
