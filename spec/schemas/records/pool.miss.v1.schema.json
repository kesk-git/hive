{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.miss:v1",
  "title": "Rule delivery miss",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "miss_id",
    "home_id",
    "scope_level",
    "subject_id",
    "rule",
    "actor",
    "step",
    "provenance",
    "provenance_history",
    "observed_at",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "pool.miss"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "miss_id": {
      "type": "string",
      "pattern": "^miss_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "subject_id": {
      "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/subject_id"
    },
    "rule": {
      "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/rendering/properties/rules/items"
    },
    "actor": {
      "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer_ref"
    },
    "step": {
      "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/step"
    },
    "provenance": {
      "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/provenance"
    },
    "provenance_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provenance",
          "changed_at",
          "changed_by",
          "request_id"
        ],
        "properties": {
          "provenance": {
            "$ref": "urn:hive:schema:records:pool.subject:v1#/$defs/provenance"
          },
          "changed_at": {
            "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
          },
          "changed_by": {
            "$ref": "urn:hive:schema:common:v1#/$defs/caller"
          },
          "request_id": {
            "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
          }
        }
      }
    },
    "observed_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    }
  ]
}
