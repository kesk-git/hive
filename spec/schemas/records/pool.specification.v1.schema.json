{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.specification:v1",
  "title": "Specification",
  "description": "One native specification with its revisions, acceptance and closures, at pool/records/specification/<specification_id>.json. Its accepted criteria are carried into an item and rendered into the Imperative's Standard by revision; there is no second editable copy. See spec/pool.md, Specifications.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "specification_id",
    "scope_level",
    "home_id",
    "title",
    "current_revision",
    "revisions",
    "closures",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "pool.specification"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1",
        "1.2"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "specification_id": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/specification_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "title": {
      "$ref": "urn:hive:schema:common:v1#/$defs/label"
    },
    "current_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "revisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/revision"
      }
    },
    "acceptances": {
      "description": "Every acceptance recorded, one per item it was recorded for, each at the revision that item was bound to. Appended by accept; an entry is marked invalidated by a later revision whose criteria differ from the criteria of the revision that entry accepted, whichever revision that is.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/acceptance"
      }
    },
    "closures": {
      "description": "Every closure recorded, each binding accepted requirements to a landed head and its proof.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/closure"
      }
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    }
  ],
  "$defs": {
    "criterion_id": {
      "description": "Stable within the specification across revisions.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "criterion": {
      "description": "One acceptance criterion: what must hold and what evidence shows it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "text",
        "evidence"
      ],
      "properties": {
        "criterion_id": {
          "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/criterion_id"
        },
        "text": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "evidence": {
          "description": "The evidence that proves it, in words.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "requirements": {
          "description": "The requirements this criterion answers: Hive records by reference, or documents by URL.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/link"
          }
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "text",
        "criteria",
        "digest",
        "defined_at",
        "defined_by",
        "authority",
        "request_id"
      ],
      "properties": {
        "revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "text": {
          "description": "The specification's prose, kept exactly.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/criterion"
          }
        },
        "changed_criteria": {
          "description": "For a revision after the first: the criteria whose text or evidence differs from the revision before, by identity, as information. Invalidation does not read this list: it compares this revision's criteria with the criteria of each revision an item is currently bound to.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.specification:v1#/$defs/criterion_id"
          }
        },
        "digest": {
          "description": "Digest of canonical text and criteria, with touched_subjects, product_rules and plan_stage when present; absent optional members keep their historical digest input.",
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "defined_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "defined_by": {
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "authority": {
          "$ref": "urn:hive:schema:common:v1#/$defs/authority"
        },
        "request_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        },
        "touched_subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
          }
        },
        "product_rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "record_revision"
            ],
            "properties": {
              "rule_id": {
                "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
              },
              "record_revision": {
                "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
              }
            }
          }
        },
        "plan_stage": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "task_id",
        "digest",
        "state",
        "accepted_at",
        "accepted_by",
        "receipt_id"
      ],
      "properties": {
        "revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "digest": {
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "state": {
          "enum": [
            "accepted",
            "invalidated"
          ]
        },
        "accepted_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "accepted_by": {
          "description": "The Fleet's supervisor, or the Hive for its own item.",
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "task_id": {
          "description": "The item the acceptance was recorded for and bound to.",
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "admission": {
          "description": "The admission revision the acceptance relates to, where there is one.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "receipt_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        },
        "invalidated_by": {
          "description": "The revision whose criteria differ from the criteria this acceptance accepted.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "invalidated_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "need_test": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "coverage",
            "reason"
          ],
          "properties": {
            "outcome": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            },
            "coverage": {
              "enum": [
                "existing",
                "new-definition"
              ]
            },
            "reason": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            },
            "covering_specification": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/criteria_ref"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "coverage": {
                    "const": "existing"
                  }
                }
              },
              "then": {
                "required": [
                  "covering_specification"
                ]
              },
              "else": {
                "properties": {
                  "covering_specification": false
                }
              }
            }
          ]
        },
        "open_product_questions": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "invalidated"
              }
            }
          },
          "then": {
            "required": [
              "invalidated_by",
              "invalidated_at"
            ]
          },
          "else": {
            "properties": {
              "invalidated_by": false,
              "invalidated_at": false
            }
          }
        }
      ],
      "description": "One acceptance of one revision for one item."
    },
    "closure": {
      "description": "Accepted requirements closed against a landed head. Recorded after a verified landing, separately from the landing itself.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "task_id",
        "generation",
        "landed_revision",
        "landing",
        "proof",
        "resolved_findings",
        "closed_at",
        "closed_by",
        "receipt_id"
      ],
      "properties": {
        "revision": {
          "description": "The accepted specification revision closed.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "task_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "generation": {
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        },
        "landed_revision": {
          "description": "The landed head.",
          "$ref": "urn:hive:schema:common:v1#/$defs/git_revision"
        },
        "landing": {
          "description": "The receipt of the verified landing, as the caller named it.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "proof": {
          "description": "The proof receipts bound to that head, as the caller named them.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
          }
        },
        "resolved_findings": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
          }
        },
        "closed_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "closed_by": {
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "receipt_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        }
      }
    },
    "need_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "coverage",
        "reason"
      ],
      "properties": {
        "outcome": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "coverage": {
          "enum": [
            "existing",
            "new-definition"
          ]
        },
        "reason": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "covering_specification": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/criteria_ref"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "coverage": {
                "const": "existing"
              }
            }
          },
          "then": {
            "required": [
              "covering_specification"
            ]
          },
          "else": {
            "properties": {
              "covering_specification": false
            }
          }
        }
      ]
    }
  }
}
