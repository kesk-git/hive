{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.imperative:v1",
  "title": "Canonical Imperative",
  "description": "The canonical Imperative of one Pool item, at pool/records/imperative/<task_id>.json: every revision with its four sections and the typed fields admission reads, its digest, and what was delivered for each generation. It is private and never enters a repository, a Harvest, a comment or a log. See spec/pool.md, The Imperative.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "task_id",
    "scope_level",
    "home_id",
    "current_revision",
    "revisions",
    "deliveries",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "pool.imperative"
    },
    "schema_version": {
      "enum": [
        "1.0",
        "1.1"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "task_id": {
      "description": "The record's identity: one Imperative per item.",
      "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "clone_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/clone_id"
    },
    "current_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "revisions": {
      "description": "Every revision, in order from 1. A revision is never changed; steering writes the next one.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/revision"
      }
    },
    "deliveries": {
      "description": "Exactly what was delivered for each generation, recorded by hive-imperative deliver when a later stage launches.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/delivery"
      }
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    }
  ],
  "$defs": {
    "confidence": {
      "description": "high: filled with high confidence from the words and the record. guess: a genuine guess that would change what gets built; admission holds it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "high",
            "guess"
          ]
        },
        "question": {
          "description": "For a guess: what must be asked.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "consequence": {
          "description": "For a guess: what changes in what gets built.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "level": {
                "const": "guess"
              }
            }
          },
          "then": {
            "required": [
              "question",
              "consequence"
            ]
          },
          "else": {
            "properties": {
              "question": false,
              "consequence": false
            }
          }
        }
      ]
    },
    "object": {
      "description": "Object: the project, the task and the concrete artifact or behavior.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "artifact",
        "confidence"
      ],
      "properties": {
        "text": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "artifact": {
          "description": "The concrete artifact or behavior, named.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "confidence": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/confidence"
        }
      }
    },
    "standard": {
      "description": "Standard: acceptance conditions, required evidence and the authoritative requirements and rules. Criteria come from the specification revision named and are rendered from it; there is no editable copy here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conditions",
        "evidence",
        "confidence"
      ],
      "properties": {
        "conditions": {
          "description": "The acceptance conditions in the Imperative's own words, apart from the specification's criteria.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "criteria": {
          "description": "The accepted specification revision whose criteria are rendered into this section, by revision. Must equal the item's effective specification, its own binding or its parent's; absent only for an item that has none.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/criteria_ref"
        },
        "evidence": {
          "description": "Each piece of evidence the result must carry.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "rules_digest": {
          "description": "The resolved-rule digest the author wrote against, from hive-rule resolve.",
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "confidence": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/confidence"
        }
      }
    },
    "task_section": {
      "description": "Task: the Hive Mind's intent, kept apart from the Fleet's implementation specification, then Object and Standard.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "object",
        "standard"
      ],
      "properties": {
        "intent": {
          "description": "The Hive Mind's intent, as given. Implementation choices never become purported intent.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "object": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/object"
        },
        "standard": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/standard"
        }
      }
    },
    "placement_axis": {
      "description": "The Placement axis as rendered from the item: the place requested on the item at the item revision read. The author does not set it; hive-imperative copies it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested",
        "item_revision"
      ],
      "properties": {
        "requested": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/placement"
        },
        "item_revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        }
      }
    },
    "setup": {
      "description": "Setup: binds the Object to the repository, the base and source, the output branch rule, the role, the harness and placement, dependencies, tools, allowed access and isolation assertions. It implements the Boundary and cannot widen it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "base_branch",
        "source_branch",
        "output_branch_rule",
        "role",
        "harness",
        "placement",
        "dependencies",
        "tools",
        "access",
        "isolation"
      ],
      "properties": {
        "repository": {
          "description": "The project's repository binding as read from the project record at authoring. A local-only project binds no forge.",
          "$ref": "urn:hive:schema:project:v1#/$defs/repository"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "base_revision": {
          "description": "The immutable base, once known.",
          "$ref": "urn:hive:schema:common:v1#/$defs/git_revision"
        },
        "source_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "source_revision": {
          "description": "The immutable source, once known. A Void launch needs it pushed; admission holds until the caller's evidence says so.",
          "$ref": "urn:hive:schema:common:v1#/$defs/git_revision"
        },
        "output_branch_rule": {
          "description": "How the output branch is named, in words. The worker's actual branch is bound by the dispatcher at a later stage.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "role": {
          "enum": [
            "swarm",
            "lictor"
          ]
        },
        "harness": {
          "description": "claude or codex, or policy to leave the choice to the resolver. A harness that cannot run in the requested place is a contradiction admission refuses.",
          "enum": [
            "claude",
            "codex",
            "policy"
          ]
        },
        "placement": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/placement_axis"
        },
        "dependencies": {
          "description": "What the work depends on: items by reference or things in words.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "tools": {
          "description": "The tools the worker may use, by name.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credentials"
          ],
          "properties": {
            "credentials": {
              "description": "Every credential the work needs, each as a reference to the platform's secret store and never as a value.",
              "type": "array",
              "items": {
                "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/secret_ref"
              }
            },
            "network": {
              "description": "What network access the work is allowed, in words.",
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            }
          }
        },
        "isolation": {
          "description": "The assertions the worker verifies before it edits: physical working directory and repository top level for local execution, repository, base and source identity in the Void.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        }
      }
    },
    "boundary": {
      "description": "Boundary: scope, exclusions, allowed effects, resources, permissions and stop or escalation conditions, with the authorized repair scope and a finite retry limit.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "exclusions",
        "allowed_effects",
        "resources",
        "permissions",
        "stop_conditions",
        "repair_scope",
        "retry_limit",
        "sensitive",
        "confidence"
      ],
      "properties": {
        "scope": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "exclusions": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "allowed_effects": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "resources": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "permissions": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "repair_scope": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "retry_limit": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "sensitive": {
          "description": "The sensitive boundaries this work touches. Each needs the Hive Mind's explicit, applicable authority at admission; inference cannot supply it.",
          "type": "array",
          "items": {
            "enum": [
              "spend",
              "deletion",
              "security",
              "publication"
            ]
          }
        },
        "confidence": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/confidence"
        }
      }
    },
    "validation_command": {
      "description": "One complete validation command as an argument vector. It is never a line of shell.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "argv"
      ],
      "properties": {
        "name": {
          "$ref": "urn:hive:schema:common:v1#/$defs/label"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "working_directory": {
          "description": "Relative to the worker's copy of the repository.",
          "$ref": "urn:hive:schema:common:v1#/$defs/home_relative_path"
        }
      }
    },
    "rules_section": {
      "description": "Rules: the Boundary, the complete validation commands that implement the Standard, and the delivery and decision channels with the blocker owner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary",
        "validation_commands",
        "channels"
      ],
      "properties": {
        "boundary": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/boundary"
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/validation_command"
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "delivery",
            "decisions",
            "blocker_owner"
          ],
          "properties": {
            "delivery": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            },
            "decisions": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            },
            "blocker_owner": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
            }
          }
        }
      }
    },
    "output": {
      "description": "Output: the exact deliverable, its recipient, the validation and publication choices and the completion evidence against the Standard.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliverable",
        "recipient",
        "validation",
        "publication",
        "completion_evidence",
        "confidence"
      ],
      "properties": {
        "deliverable": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "recipient": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "validation": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/validation_axis"
        },
        "publication": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/publication_axis"
        },
        "completion_evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
          }
        },
        "confidence": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/confidence"
        }
      }
    },
    "definition_of_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "stopping_point"
      ],
      "properties": {
        "output": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/output"
        },
        "stopping_point": {
          "description": "Where the worker stops, defined apart from any later Assimilation.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "class",
        "task",
        "setup",
        "rules",
        "definition_of_done",
        "digest",
        "authored_at",
        "authored_by",
        "authority",
        "request_id"
      ],
      "properties": {
        "revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "class": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/dispatch_class"
        },
        "task": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/task_section"
        },
        "setup": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/setup"
        },
        "rules": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/rules_section"
        },
        "definition_of_done": {
          "$ref": "urn:hive:schema:records:pool.imperative:v1#/$defs/definition_of_done"
        },
        "digest": {
          "description": "The digest of the canonical form of this revision's class and four sections, which is what admission binds to.",
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "supersedes_reason": {
          "description": "For a revision after the first: why it was written, in words, such as the steer that changed scope.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "authored_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "authored_by": {
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "authority": {
          "$ref": "urn:hive:schema:common:v1#/$defs/authority"
        },
        "request_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        }
      }
    },
    "delivery": {
      "description": "What one generation was given: the revision, the rendered text's digest and size, the renderer, the transport, and the receipt the dispatcher named.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",
        "revision",
        "renderer_version",
        "text_digest",
        "text_bytes",
        "transport",
        "delivered_at",
        "evidence"
      ],
      "properties": {
        "generation": {
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        },
        "revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "renderer_version": {
          "$ref": "urn:hive:schema:common:v1#/$defs/implementation_version"
        },
        "text_digest": {
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "text_bytes": {
          "$ref": "urn:hive:schema:common:v1#/$defs/byte_count"
        },
        "transport": {
          "description": "How the text reached the worker: a launch prompt, a steer by session, or a public-safe rendering for a GitHub-triggered run.",
          "enum": [
            "launch-prompt",
            "steer",
            "public-safe-prompt"
          ]
        },
        "rendered_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "delivered_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "evidence": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "record_revision"
            ],
            "properties": {
              "rule_id": {
                "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
              },
              "record_revision": {
                "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
              }
            }
          }
        },
        "subject_projections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "projection_id",
              "rendering",
              "digest",
              "rules"
            ],
            "properties": {
              "projection_id": {
                "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/projection_id"
              },
              "rendering": {
                "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
              },
              "digest": {
                "$ref": "urn:hive:schema:common:v1#/$defs/digest"
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "rule_id",
                    "record_revision"
                  ],
                  "properties": {
                    "rule_id": {
                      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
                    },
                    "record_revision": {
                      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
