{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.move:v1",
  "title": "Multi-home move",
  "description": "The record of one move of items between two Pools, kept in both homes at pool/records/move/<move_id>.json. A move is a sequence of three transactions joined by receipts: prepared in the source, accepted in the destination, completed in the source. Each step is replayable and recovery finishes or aborts a move from this record. See spec/pool.md, Moves between homes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "move_id",
    "scope_level",
    "home_id",
    "role",
    "source_home_id",
    "destination_home_id",
    "items",
    "state",
    "steps",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "pool.move"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "move_id": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/move_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "home_id": {
      "description": "The home this copy of the record lives in.",
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "role": {
      "description": "Whether this home is the move's source or its destination.",
      "enum": [
        "source",
        "destination"
      ]
    },
    "source_home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "destination_home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "destination_scope": {
      "description": "The scope the items take in the destination, where it differs from the source scope.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_level"
      ],
      "properties": {
        "scope_level": {
          "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
        },
        "workspace_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
        },
        "project_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
        }
      },
      "allOf": [
        {
          "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
        }
      ]
    },
    "items": {
      "description": "Every item moved, each with its revision in the source at preparation and the digest of its content, which the destination writes unchanged apart from scope and moved_from.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "source_revision",
          "digest"
        ],
        "properties": {
          "task_id": {
            "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
          },
          "source_revision": {
            "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
          },
          "digest": {
            "$ref": "urn:hive:schema:common:v1#/$defs/digest"
          },
          "holds": {
            "description": "The active holds that travel with the item, by identity.",
            "type": "array",
            "items": {
              "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/hold_id"
            }
          }
        }
      }
    },
    "state": {
      "enum": [
        "prepared",
        "accepted",
        "completed",
        "aborted"
      ]
    },
    "steps": {
      "description": "The steps taken so far, each with the receipt that establishes it. A step of the other home is recorded here from the receipt the caller carried across.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "home_id",
          "at",
          "receipt"
        ],
        "properties": {
          "step": {
            "enum": [
              "prepare",
              "accept",
              "complete",
              "abort"
            ]
          },
          "home_id": {
            "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
          },
          "at": {
            "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
          },
          "receipt": {
            "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
          },
          "reason": {
            "description": "For an abort.",
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    }
  ]
}
