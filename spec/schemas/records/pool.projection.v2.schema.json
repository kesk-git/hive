{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.projection:v2",
  "title": "Knowledge projection",
  "description": "A generated always or subject projection for one scope and role audience, with revision-bound rules in every rendering and durable receipt history. See spec/pool.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "projection_id",
    "scope_level",
    "home_id",
    "audience",
    "current",
    "consumers",
    "created_at",
    "updated_at",
    "writer",
    "tier",
    "budget_revision",
    "receipt_history",
    "history"
  ],
  "properties": {
    "schema": {
      "const": "pool.projection"
    },
    "schema_version": {
      "enum": [
        "2.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "projection_id": {
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/projection_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "audience": {
      "enum": [
        "hive",
        "fleet",
        "class-0",
        "class-1",
        "class-2",
        "class-3",
        "class-4",
        "class-5",
        "class-6",
        "class-7",
        "reviewer",
        "fixer",
        "validation"
      ]
    },
    "current": {
      "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/rendering",
      "description": "Current rendering; each prior rendering is retained in history so delivery receipts remain bound to their exact rule inventories."
    },
    "consumers": {
      "description": "Per-consumer propagation: what each received and what each acknowledged, by digest.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer"
      }
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    },
    "tier": {
      "enum": [
        "always",
        "subject"
      ]
    },
    "subject_id": {
      "type": "string",
      "pattern": "^subj_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "budget_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "receipt_history": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer"
      }
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/rendering"
      }
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    },
    {
      "if": {
        "properties": {
          "tier": {
            "const": "always"
          }
        }
      },
      "then": {
        "properties": {
          "subject_id": false,
          "audience": {
            "enum": [
              "hive",
              "fleet"
            ]
          }
        }
      },
      "else": {
        "required": [
          "subject_id"
        ]
      }
    }
  ],
  "$defs": {
    "source": {
      "description": "One record the rendering consumed, at the revision it read. The canonical owner of each fact is the package that owns the record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "owner"
      ],
      "properties": {
        "ref": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "owner": {
          "$ref": "urn:hive:schema:common:v1#/$defs/package_name"
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendering",
        "rendered_at",
        "renderer_version",
        "rules_digest",
        "sources",
        "text",
        "digest",
        "bytes",
        "rules"
      ],
      "properties": {
        "rendering": {
          "description": "Counts renderings of this projection from 1.",
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        },
        "rendered_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "renderer_version": {
          "$ref": "urn:hive:schema:common:v1#/$defs/implementation_version"
        },
        "rules_digest": {
          "description": "The resolved-rule digest the rendering was made from. A rendering is fresh while the rules now in force for its scope resolve to this digest and every non-rule source revision and the budget revision agrees.",
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/source"
          },
          "description": "Every effective rule, canonical subject and budget configuration at the exact revisions consumed."
        },
        "text": {
          "description": "The rendered instructions.",
          "type": "string"
        },
        "digest": {
          "description": "The digest of text.",
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "bytes": {
          "$ref": "urn:hive:schema:common:v1#/$defs/byte_count"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rule_id",
              "record_revision"
            ],
            "properties": {
              "rule_id": {
                "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/rule_id"
              },
              "record_revision": {
                "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
              }
            }
          }
        }
      }
    },
    "consumer_ref": {
      "description": "Who consumed the projection: a supervisor session by identity and generation, a task generation, or a named instruction file.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "session",
            "generation"
          ]
        },
        "session_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/session_id"
        },
        "session_generation": {
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        },
        "task_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "generation": {
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session"
              }
            }
          },
          "then": {
            "required": [
              "session_id",
              "session_generation"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "generation"
              }
            }
          },
          "then": {
            "required": [
              "task_id",
              "generation"
            ]
          }
        }
      ]
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consumer",
        "received"
      ],
      "properties": {
        "consumer": {
          "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/consumer_ref"
        },
        "received": {
          "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/propagation_step"
        },
        "acknowledged": {
          "description": "Absent until the consumer acknowledged a digest. A consumer acknowledged at an older digest than current is drift.",
          "$ref": "urn:hive:schema:records:pool.projection:v2#/$defs/propagation_step"
        }
      }
    },
    "propagation_step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rendering",
        "digest",
        "at",
        "receipt_id"
      ],
      "properties": {
        "rendering": {
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        },
        "digest": {
          "$ref": "urn:hive:schema:common:v1#/$defs/digest"
        },
        "at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "evidence": {
          "description": "The consumer's own receipt or record, where it gave one.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "receipt_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        }
      }
    }
  }
}
