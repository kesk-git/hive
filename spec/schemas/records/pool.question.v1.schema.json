{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:records:pool.question:v1",
  "title": "Question held for the Hive Mind",
  "description": "One question the Hive Mind owes, with its revisions, the hold it gates and every answer recorded against it, at pool/records/question/<question_id>.json. It is what the Mind's word persists through the Pool: word mints its identity, pool writes it. Answers are kept exactly as given. See spec/word.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "record_revision",
    "question_id",
    "scope_level",
    "home_id",
    "held_task_id",
    "hold_id",
    "origin",
    "current_revision",
    "revisions",
    "state",
    "answers",
    "created_at",
    "updated_at",
    "writer"
  ],
  "properties": {
    "schema": {
      "const": "pool.question"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "record_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "question_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
    },
    "scope_level": {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_level"
    },
    "home_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/home_id"
    },
    "workspace_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/workspace_id"
    },
    "project_id": {
      "$ref": "urn:hive:schema:common:v1#/$defs/project_id"
    },
    "held_task_id": {
      "description": "The item the question holds: the work it gates, or an item made for a question with its own scope.",
      "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
    },
    "hold_id": {
      "description": "The word hold placed on that item for this question.",
      "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/hold_id"
    },
    "origin": {
      "$ref": "urn:hive:schema:records:pool.question:v1#/$defs/origin"
    },
    "current_revision": {
      "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
    },
    "revisions": {
      "description": "Every revision of the question as asked. A changed question is a new revision; an answer to an earlier revision waits for reconciliation.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:hive:schema:records:pool.question:v1#/$defs/revision"
      }
    },
    "state": {
      "description": "open: awaiting the Hive Mind. deferred: Later was chosen; still awaiting. answered: an answer was accepted and the hold released or the question stands answered. completed: nothing further is owed. superseded: replaced by another question.",
      "enum": [
        "open",
        "deferred",
        "answered",
        "completed",
        "superseded"
      ]
    },
    "answers": {
      "description": "Every answer recorded, in sequence, applied or not. Nothing here is ever changed.",
      "type": "array",
      "items": {
        "$ref": "urn:hive:schema:records:pool.question:v1#/$defs/answer"
      }
    },
    "deferral": {
      "description": "The current revisit date, from the latest answer that chose Later. The Shadow reads it as a dated hold; reaching it re-presents the question and runs nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revisit_at",
        "answer_sequence"
      ],
      "properties": {
        "revisit_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "answer_sequence": {
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_at",
        "completed_by",
        "request_id",
        "receipt_id"
      ],
      "properties": {
        "completed_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "completed_by": {
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "evidence": {
          "description": "What carried the decision's consequence out, where the owner named it.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "request_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        },
        "receipt_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        }
      }
    },
    "superseded_by": {
      "$ref": "urn:hive:schema:common:v1#/$defs/question_id"
    },
    "created_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
    },
    "writer": {
      "$ref": "urn:hive:schema:common:v1#/$defs/writer"
    },
    "unknown": {
      "$ref": "urn:hive:schema:common:v1#/$defs/open_object"
    }
  },
  "allOf": [
    {
      "$ref": "urn:hive:schema:common:v1#/$defs/scope_rules"
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "deferred"
          }
        }
      },
      "then": {
        "required": [
          "deferral"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "completed"
          }
        }
      },
      "then": {
        "required": [
          "completion"
        ]
      },
      "else": {
        "properties": {
          "completion": false
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "superseded"
          }
        }
      },
      "then": {
        "required": [
          "superseded_by"
        ]
      },
      "else": {
        "properties": {
          "superseded_by": false
        }
      }
    }
  ],
  "$defs": {
    "origin": {
      "description": "Where the question arose: a Lictor's decision inventory, an admission hold, a specification's product gap, a review round, a session instruction or the supervisor, with the record that raised it.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "lictor-report",
            "admission",
            "specification",
            "review",
            "session",
            "supervisor",
            "spend",
            "legacy"
          ]
        },
        "ref": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_ref"
        },
        "task_id": {
          "description": "The task whose work raised the question, where it differs from the held item.",
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "generation": {
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "label",
        "consequence"
      ],
      "properties": {
        "option_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/option_id"
        },
        "label": {
          "$ref": "urn:hive:schema:common:v1#/$defs/label"
        },
        "consequence": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        }
      }
    },
    "revision": {
      "description": "The question as asked at one revision: its text, the consequence of leaving it, the recommendation first, then the alternatives. Free text is always accepted as an answer, with or without an option.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "text",
        "consequence",
        "options",
        "asked_at",
        "asked_by",
        "request_id"
      ],
      "properties": {
        "revision": {
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "text": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "consequence": {
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "recommendation": {
          "description": "The recommended option, first on every card.",
          "$ref": "urn:hive:schema:common:v1#/$defs/option_id"
        },
        "options": {
          "description": "The recommendation and the alternatives. May be empty for a question that takes free text only.",
          "type": "array",
          "items": {
            "$ref": "urn:hive:schema:records:pool.question:v1#/$defs/option"
          }
        },
        "amount": {
          "description": "For a spend ask: the amount and its unit, as text, with the reason in the question's text.",
          "$ref": "urn:hive:schema:records:pool.item:v1#/$defs/text"
        },
        "asked_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "asked_by": {
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "request_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        }
      }
    },
    "answer_source": {
      "description": "The evidence the answer rests on, required and recorded with the answer, so a reader always sees where the words came from. A review submission is the submit event of a review round. A session input is the input receipt of the supervisor session the words were typed into. An operator request is the request_id of the hive-word answer request typed at a terminal; it has no further evidence, and the record shows it as exactly that. Two answers to the same question with the same source are one answer; one source, a submit event or a session input, may carry answers to several questions, each its own.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "review-submission",
            "session-input",
            "operator-request"
          ]
        },
        "task_id": {
          "description": "For a review submission: the task of the review directory the round file lives in.",
          "$ref": "urn:hive:schema:common:v1#/$defs/task_id"
        },
        "generation": {
          "description": "For a review submission: the generation of the review directory.",
          "$ref": "urn:hive:schema:common:v1#/$defs/generation"
        },
        "review_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/review_id"
        },
        "round_id": {
          "type": "integer",
          "minimum": 1
        },
        "feedback_event_id": {
          "description": "For a review submission: the submit event of the round's feedback file that carries the words.",
          "$ref": "urn:hive:schema:common:v1#/$defs/feedback_event_id"
        },
        "input_id": {
          "description": "For a session input: the input the words arrived in.",
          "$ref": "urn:hive:schema:common:v1#/$defs/input_id"
        },
        "receipt_id": {
          "description": "For a session input: the input receipt of the supervisor session that accepted it.",
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        },
        "request_id": {
          "description": "For an operator request: the request_id of the hive-word answer request, which is the key of the source.",
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "review-submission"
              }
            }
          },
          "then": {
            "required": [
              "task_id",
              "generation",
              "review_id",
              "round_id",
              "feedback_event_id"
            ],
            "properties": {
              "input_id": false,
              "receipt_id": false,
              "request_id": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "session-input"
              }
            }
          },
          "then": {
            "required": [
              "input_id",
              "receipt_id"
            ],
            "properties": {
              "task_id": false,
              "generation": false,
              "review_id": false,
              "round_id": false,
              "feedback_event_id": false,
              "request_id": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "operator-request"
              }
            }
          },
          "then": {
            "required": [
              "request_id"
            ],
            "properties": {
              "task_id": false,
              "generation": false,
              "review_id": false,
              "round_id": false,
              "feedback_event_id": false,
              "input_id": false,
              "receipt_id": false
            }
          }
        }
      ]
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence",
        "question_revision",
        "card",
        "text",
        "source",
        "answered_at",
        "recorded_at",
        "recorded_by",
        "disposition",
        "request_id",
        "receipt_id"
      ],
      "properties": {
        "sequence": {
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        },
        "question_revision": {
          "description": "The revision the answer was given against. When it is not the current revision the answer is recorded unreconciled.",
          "$ref": "urn:hive:schema:common:v1#/$defs/record_revision"
        },
        "card": {
          "description": "The card the answer was given on, with the question, held item and decision round at the revisions the Hive Mind was shown. They are recorded as what was shown; only the question revision and the card revision are grounds to treat the answer as changed.",
          "$ref": "urn:hive:schema:review:v1#/$defs/card_binding"
        },
        "option_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/option_id"
        },
        "option_label": {
          "description": "The option's label exactly as it was displayed.",
          "type": "string"
        },
        "text": {
          "description": "The free text exactly as given, whitespace included. May be empty only when an option was chosen or Later was chosen.",
          "type": "string"
        },
        "later": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "revisit_at"
          ],
          "properties": {
            "revisit_at": {
              "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
            }
          }
        },
        "source": {
          "$ref": "urn:hive:schema:records:pool.question:v1#/$defs/answer_source"
        },
        "answered_at": {
          "description": "When the Hive Mind gave the answer, as the source states it.",
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "recorded_at": {
          "$ref": "urn:hive:schema:common:v1#/$defs/timestamp"
        },
        "recorded_by": {
          "description": "Who brought the answer to the intake.",
          "$ref": "urn:hive:schema:common:v1#/$defs/caller"
        },
        "disposition": {
          "description": "released: the hold was released. completed: the question stands answered with nothing to release. deferred: Later. unreconciled: given against an earlier revision; recorded, not applied. superseded: a later answer replaced it. reconciles names the unreconciled answer a later answer settles.",
          "enum": [
            "released",
            "completed",
            "deferred",
            "unreconciled",
            "superseded"
          ]
        },
        "supersedes": {
          "description": "The sequence of the answer this one replaces, under the Hive Mind's authority.",
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        },
        "reconciles": {
          "$ref": "urn:hive:schema:common:v1#/$defs/sequence"
        },
        "request_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/request_id"
        },
        "receipt_id": {
          "$ref": "urn:hive:schema:common:v1#/$defs/receipt_id"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "option_id"
            ]
          },
          "then": {
            "required": [
              "option_label"
            ]
          },
          "else": {
            "properties": {
              "option_label": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "deferred"
              }
            }
          },
          "then": {
            "required": [
              "later"
            ]
          },
          "else": {
            "properties": {
              "later": false
            }
          }
        },
        {
          "anyOf": [
            {
              "required": [
                "option_id"
              ]
            },
            {
              "required": [
                "later"
              ]
            },
            {
              "properties": {
                "text": {
                  "minLength": 1
                }
              }
            }
          ]
        }
      ]
    }
  }
}
