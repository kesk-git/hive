{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:hive:schema:import-record:v1",
  "title": "Import record",
  "description": "One file under imports/ for each body of upstream material taken into this repository. See spec/imports.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "import_id",
    "kind",
    "owner",
    "recorded_on",
    "upstream",
    "licence",
    "portions",
    "retained_tests",
    "transitive",
    "excluded",
    "local_changes",
    "audit"
  ],
  "properties": {
    "schema": {
      "const": "hive.import"
    },
    "schema_version": {
      "enum": [
        "1.0"
      ]
    },
    "import_id": {
      "description": "Also the file name, imports/<import_id>.json, and the name of the notices directory.",
      "$ref": "urn:hive:schema:common:v1#/$defs/slug"
    },
    "kind": {
      "description": "adaptation: upstream source text was copied and changed. translation: upstream behavior was re-expressed in another language from its source. dependency: a third-party module is compiled into a delivered executable. asset: a non-code file was taken as it is.",
      "enum": [
        "adaptation",
        "translation",
        "dependency",
        "asset"
      ]
    },
    "owner": {
      "description": "The package that maintains the imported material, or contract for the shared library.",
      "enum": [
        "pool",
        "spawning-pool",
        "dispatch",
        "shadow",
        "synapse",
        "word",
        "ui",
        "contract"
      ]
    },
    "recorded_on": {
      "description": "The calendar date the record was first committed.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "repository",
        "revision"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "repository": {
          "description": "The public source location.",
          "type": "string",
          "pattern": "^https://[^\\s]+$",
          "maxLength": 500
        },
        "revision": {
          "description": "The exact upstream commit the material was taken from.",
          "$ref": "urn:hive:schema:common:v1#/$defs/git_revision"
        },
        "tag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "module": {
          "description": "For a dependency: the module path and version the build pins.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "version"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        }
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "copyright",
        "files"
      ],
      "properties": {
        "spdx": {
          "description": "The SPDX expression established for the imported portions, from the files themselves and not from the repository's label alone.",
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "copyright": {
          "description": "Every copyright notice that applies, verbatim.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "description": "The upstream licence and notice texts retained in this repository, unchanged. Paths are relative to the repository root.",
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "urn:hive:schema:common:v1#/$defs/file_ref"
          }
        }
      }
    },
    "portions": {
      "description": "Every file of this repository that holds imported material. Paths are relative to the repository root.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hive_path",
          "upstream_paths",
          "disposition"
        ],
        "properties": {
          "hive_path": {
            "$ref": "urn:hive:schema:common:v1#/$defs/home_relative_path"
          },
          "upstream_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:hive:schema:common:v1#/$defs/home_relative_path"
            }
          },
          "disposition": {
            "enum": [
              "copied",
              "adapted",
              "translated"
            ]
          }
        }
      }
    },
    "retained_tests": {
      "description": "The upstream tests kept with the import, and where each lives here. A translated test names the upstream test it re-expresses.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "hive_path",
          "upstream_paths",
          "disposition"
        ],
        "properties": {
          "hive_path": {
            "$ref": "urn:hive:schema:common:v1#/$defs/home_relative_path"
          },
          "upstream_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "urn:hive:schema:common:v1#/$defs/home_relative_path"
            }
          },
          "disposition": {
            "enum": [
              "copied",
              "adapted",
              "translated"
            ]
          }
        }
      }
    },
    "transitive": {
      "description": "Every third-party library the imported portions bring with them, each with its own established licence.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "spdx",
          "disposition"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "spdx": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "disposition": {
            "description": "recorded: it has its own import record. replaced: Hive supplies the function natively and takes nothing. dropped: the imported portions no longer need it.",
            "enum": [
              "recorded",
              "replaced",
              "dropped"
            ]
          },
          "import_id": {
            "$ref": "urn:hive:schema:common:v1#/$defs/slug"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "disposition": {
                  "const": "recorded"
                }
              }
            },
            "then": {
              "required": [
                "import_id"
              ]
            },
            "else": {
              "properties": {
                "import_id": false
              }
            }
          }
        ]
      }
    },
    "excluded": {
      "description": "What the audit looked at and left out, and why: generated assets, bundled files under other terms, anything with unestablished provenance.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "upstream_path",
          "reason"
        ],
        "properties": {
          "upstream_path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "local_changes": {
      "description": "What Hive changed, in plain words, kept current as the import is maintained.",
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "description": "The check made before the import: selected source, tests, generated assets and transitive libraries.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audited_on",
        "statement"
      ],
      "properties": {
        "audited_on": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "dependency"
          }
        }
      },
      "then": {
        "properties": {
          "upstream": {
            "required": [
              "module"
            ]
          }
        }
      },
      "else": {
        "properties": {
          "portions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
